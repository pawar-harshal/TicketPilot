        </mxCell>

        <mxCell id="lane_agent" value="AgentOrchestrator" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="240" y="60" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="line_agent" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="320" y="100" as="sourcePoint" /><mxPoint x="320" y="830" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="lane_llm" value="LLM" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="450" y="60" width="110" height="40" as="geometry" />
        </mxCell>
        <mxCell id="line_llm" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="505" y="100" as="sourcePoint" /><mxPoint x="505" y="830" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="lane_tools" value="Tools&#10;(Order/Account/KB lookup)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="60" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="line_tools" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="680" y="100" as="sourcePoint" /><mxPoint x="680" y="830" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="lane_mgr" value="Support Manager" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="800" y="60" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="line_mgr" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="870" y="100" as="sourcePoint" /><mxPoint x="870" y="830" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="m1" value="1. submitTicket(message, order_id REQUIRED) / reopenTicket(ticket_id, message)" style="html=1;fontSize=11;endArrow=block;" edge="1" parent="1" source="lane_cust" target="lane_agent">
          <mxGeometry relative="1" y="60" as="geometry"><mxPoint as="offset"/></mxGeometry>
        </mxCell>

        <mxCell id="m1b" value="1b. message appended to TicketMessage (conversation history)" style="html=1;fontSize=10;endArrow=none;dashed=1;fontColor=#666666;" edge="1" parent="1" source="lane_agent" target="lane_agent">
          <mxGeometry relative="1" y="85" as="geometry"><mxPoint as="offset"/></mxGeometry>
        </mxCell>

        <mxCell id="m2" value="2. send full TicketMessage history + closed tool set to LLM&#10;(HTTP request stays open — synchronous)" style="html=1;fontSize=11;endArrow=block;" edge="1" parent="1" source="lane_agent" target="lane_llm">
          <mxGeometry relative="1" y="110" as="geometry"><mxPoint as="offset"/></mxGeometry>
        </mxCell>

        <mxCell id="m3" value="3. tool_call: check_order_status()" style="html=1;fontSize=11;endArrow=block;dashed=1;" edge="1" parent="1" source="lane_llm" target="lane_agent">
          <mxGeometry relative="1" y="160" as="geometry"><mxPoint as="offset"/></mxGeometry>
        </mxCell>

        <mxCell id="m4" value="4. execute tool — scoped to this ticket's own customer only" style="html=1;fontSize=11;endArrow=block;" edge="1" parent="1" source="lane_agent" target="lane_tools">
          <mxGeometry relative="1" y="210" as="geometry"><mxPoint as="offset"/></mxGeometry>
        </mxCell>

        <mxCell id="m5" value="5. order data returned" style="html=1;fontSize=11;endArrow=block;" edge="1" parent="1" source="lane_tools" target="lane_agent">
          <mxGeometry relative="1" y="260" as="geometry"><mxPoint as="offset"/></mxGeometry>
        </mxCell>

        <mxCell id="m6" value="6. tool result returned to LLM" style="html=1;fontSize=11;endArrow=block;" edge="1" parent="1" source="lane_agent" target="lane_llm">
          <mxGeometry relative="1" y="310" as="geometry"><mxPoint as="offset"/></mxGeometry>
        </mxCell>

        <mxCell id="m7" value="7. decision: reply / escalate / propose_action" style="html=1;fontSize=11;endArrow=block;dashed=1;" edge="1" parent="1" source="lane_llm" target="lane_agent">
          <mxGeometry relative="1" y="360" as="geometry"><mxPoint as="offset"/></mxGeometry>
        </mxCell>

        <mxCell id="note1" value="If reply: ticket marked resolved, reply sent to customer directly (step 8a).&#10;If propose_action: pending row written to approvals (step 8b), nothing executed yet." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="410" width="340" height="55" as="geometry" />
        </mxCell>

        <mxCell id="m8a" value="8a. resolution reply" style="html=1;fontSize=11;endArrow=block;" edge="1" parent="1" source="lane_agent" target="lane_cust">
          <mxGeometry relative="1" y="490" as="geometry"><mxPoint as="offset"/></mxGeometry>
        </mxCell>

        <mxCell id="m8b" value="8b. proposed action awaiting approval" style="html=1;fontSize=11;endArrow=block;" edge="1" parent="1" source="lane_agent" target="lane_mgr">
          <mxGeometry relative="1" y="540" as="geometry"><mxPoint as="offset"/></mxGeometry>
        </mxCell>

        <mxCell id="m9" value="9. approveAction(approval_id)" style="html=1;fontSize=11;endArrow=block;" edge="1" parent="1" source="lane_mgr" target="lane_agent">
          <mxGeometry relative="1" y="600" as="geometry"><mxPoint as="offset"/></mxGeometry>
        </mxCell>

        <mxCell id="note2" value="Refund/credit executed against the order.&#10;AuditLog row written. approver_id references User." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="640" width="280" height="50" as="geometry" />
        </mxCell>

        <mxCell id="m10" value="10. ticket resolved, confirmation sent (TicketMessage row)" style="html=1;fontSize=11;endArrow=block;" edge="1" parent="1" source="lane_agent" target="lane_cust">
          <mxGeometry relative="1" y="720" as="geometry"><mxPoint as="offset"/></mxGeometry>
        </mxCell>

        <mxCell id="m11" value="11. if unsatisfied: reopenTicket — status back to investigating, resolved_at cleared, new message appended" style="html=1;fontSize=10;endArrow=block;dashed=1;fontColor=#666666;" edge="1" parent="1" source="lane_cust" target="lane_agent">
          <mxGeometry relative="1" y="770" as="geometry"><mxPoint as="offset"/></mxGeometry>
        </mxCell>

      </root>
